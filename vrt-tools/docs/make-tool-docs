#! /bin/bash

# make-tool-docs
#
# Generate Markdown documentation for VRT tools using Markdown help
# (libvrt.mdhelp) to docs/tools/, and optionally HTML and man pages
# with Pandoc.


progname=$(basename "$0")
docdir=$(dirname "$(realpath "$0")")
vrtdir=$(dirname "$docdir")
mddir=$docdir/tools
filter=$docdir/tool-doc.lua
# Disable smart punctuation so that "--option" in text is not
# converted to an en dash, and sub- and superscripts to keep "^" and
# "~" as they are
pandoc_from=markdown-smart-subscript-superscript

check=
htmldir=
mandir=
# The temporary file used by update_file, removed on exit
tmp=

trap 'rm -f "$tmp"' EXIT
trap 'exit 1' HUP INT TERM


usage () {
    cat <<EOF
Usage: $progname [options] [tool ...]

Generate Markdown documentation for VRT tools (default: all tools
using Markdown help; in a Git working tree, only those tracked by Git)
to $mddir
from the output of "tool --help-markdown", and update the index
README.md there. When generating for all tools, also remove the
Markdown files of other tools. Optionally, generate HTML and man pages
from the Markdown files with Pandoc.

Options:
  --check       only check that the Markdown files are up to date
                (and without tool arguments, that there are no
                obsolete ones); exit with status 1 if not
  --html DIR    also generate HTML to DIR
  --man DIR     also generate man pages to DIR/man1
  -h, --help    show this help and exit
EOF
}


error () {
    echo "$progname: $*" >&2
    exit 1
}


# List the tools whose script or implementation module enables
# Markdown help. (The tools are not run with --help-markdown to find
# out, as tools not using argparse might not handle it gracefully.)
# Grep all files at once, as running grep for each of the about 100
# scripts would take about a second. In a Git working tree, consider
# only scripts tracked by Git, so that untracked scratch copies are
# skipped (a new tool must thus be added to Git to be found);
# otherwise, skip names containing "~" or "." (backups).
find_tools () (
    local pattern='enable_markdown_help\(|markdown_help *= *True'
    local scripts modules script
    cd "$vrtdir" || exit 1
    if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        readarray -t scripts < <(git ls-files 'vrt-*' 'hrt-*')
    else
        scripts=()
        for script in vrt-* hrt-*; do
            [[ -e $script && $script != *[~.]* ]] && scripts+=("$script")
        done
    fi
    [ ${#scripts[@]} -gt 0 ] || exit 0
    # The implementation modules enabling Markdown help, as a regular
    # expression "libvrt\.tools\.mod1|libvrt\.tools\.mod2|..."
    modules=$(grep -l -E "$pattern" libvrt/tools/*.py 2> /dev/null |
                  sed -e 's/\.py$//; s,/,\\.,g' | paste -s -d '|')
    {
        grep -l -E "$pattern" "${scripts[@]}"
        if [ -n "$modules" ]; then
            grep -l -E "($modules)\b" "${scripts[@]}"
        fi
    } 2> /dev/null |
        sort -u |
        while read -r script; do
            if [ -x "$script" ]; then
                echo "$script"
            fi
        done
)


# Output Markdown documentation for tool $1
gen_md () {
    local tool=$1
    printf '<!-- Generated by docs/make-tool-docs from "%s"; %s -->\n\n' \
        "$tool --help-markdown" "do not edit."
    "$vrtdir/$tool" --help-markdown < /dev/null ||
        error "Failed to run $tool --help-markdown"
}


# Output the first sentence of the description in Markdown file $1
first_sentence () {
    awk '
        /^## Description$/ { descr = 1; next }
        descr && NF { para = para (para ? " " : "") $0; next }
        descr && para { exit }
        END { print para }' "$1" |
        sed -E 's/^([^.]*[^ .]\.)( .*)?$/\1/'
}


# Output the index of the Markdown files in $mddir
gen_index () {
    local file tool
    cat <<EOF
<!-- Generated by docs/make-tool-docs; do not edit. -->

# VRT Tools documentation

This documentation is generated from the usage information of the
tools by running \`docs/make-tool-docs\`.

EOF
    for file in "$mddir"/*.md; do
        tool=$(basename "$file" .md)
        [ -e "$file" ] && [ "$tool" != README ] || continue
        echo "- [$tool]($tool.md): $(first_sentence "$file")"
    done
}


# Write the output of command "$2 ..." to file $1, or with --check,
# only compare it to $1. Return 1 if $1 was out of date.
update_file () {
    local file=$1
    shift
    local status=0
    tmp=$(mktemp) || exit 1
    "$@" > "$tmp" || exit 1
    if cmp -s "$tmp" "$file"; then
        :
    elif [ -n "$check" ]; then
        echo "Out of date: $file"
        status=1
    else
        # Overwrite instead of moving $tmp, to keep the mode and group
        # of an existing file (mktemp creates files with mode 0600)
        cat "$tmp" > "$file" || exit 1
        echo "Updated: $file"
    fi
    rm -f "$tmp"
    tmp=
    return $status
}


# Remove (or with --check, only report) the Markdown files of tools
# not in "${tools[@]}". Return 1 if any were found with --check.
remove_obsolete () {
    local file tool status=0
    for file in "$mddir"/*.md; do
        tool=$(basename "$file" .md)
        [ -e "$file" ] && [ "$tool" != README ] || continue
        printf '%s\n' "${tools[@]}" | grep -qxF -- "$tool" && continue
        if [ -n "$check" ]; then
            echo "Obsolete: $file"
            status=1
        else
            rm -f -- "$file"
            echo "Removed: $file"
        fi
    done
    return $status
}


run_pandoc () {
    local tool=$1
    local format=$2
    local outfile=$3
    shift 3
    pandoc --standalone --from=$pandoc_from --to=$format \
           --lua-filter="$filter" --output="$outfile" "$@" \
           "$mddir/$tool.md" ||
        error "Pandoc failed for $mddir/$tool.md"
}


# Parse options by hand, so that VRT Tools do not depend on shell
# libraries outside vrt-tools/
while [ $# -gt 0 ]; do
    case $1 in
        --check )
            check=1
            ;;
        --html | --man )
            [ $# -ge 2 ] || error "Option $1 requires an argument"
            if [ "$1" = --html ]; then
                htmldir=$2
            else
                mandir=$2
            fi
            shift
            ;;
        -h | --help )
            usage
            exit 0
            ;;
        -* )
            error "Unknown option: $1"
            ;;
        * )
            break
            ;;
    esac
    shift
done

all_tools=
if [ $# -gt 0 ]; then
    tools=("$@")
else
    readarray -t tools < <(find_tools)
    all_tools=1
fi
if [ -n "$htmldir$mandir" ] && ! type pandoc > /dev/null 2>&1; then
    error "Pandoc is required for generating HTML or man pages"
fi

mkdir -p -- "$mddir"
status=0
for tool in "${tools[@]}"; do
    case $tool in
        */* )
            error "Not a tool name: $tool"
            ;;
    esac
    [ -x "$vrtdir/$tool" ] || error "Tool not found: $tool"
    update_file "$mddir/$tool.md" gen_md "$tool" || status=1
done
if [ -n "$all_tools" ]; then
    remove_obsolete || status=1
fi
update_file "$mddir/README.md" gen_index || status=1
[ -n "$check" ] && exit $status

if [ -n "$htmldir" ]; then
    mkdir -p -- "$htmldir"
    for tool in "${tools[@]}" README; do
        outname=$tool
        [ "$tool" = README ] && outname=index
        run_pandoc "$tool" html "$htmldir/$outname.html"
    done
    echo "Generated HTML to $htmldir"
fi

if [ -n "$mandir" ]; then
    mkdir -p -- "$mandir/man1"
    for tool in "${tools[@]}"; do
        version=$("$vrtdir/$tool" --version 2> /dev/null |
                      sed -e 's/^[^:]*: //')
        run_pandoc "$tool" man "$mandir/man1/$tool.1" \
                   --metadata=summary="$(first_sentence "$mddir/$tool.md")" \
                   --metadata=header="VRT Tools" \
                   --metadata=footer="$version" \
                   --metadata=date="$(date +%Y-%m-%d)"
    done
    echo "Generated man pages to $mandir/man1"
fi
