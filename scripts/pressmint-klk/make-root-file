def main(args):
    here = Path('.').resolve()
    if here.name == 'PressMint-FI':
        root = here.name + ('.ana' if args.ana else '')
        print('root:', root)
    else:
        raise ValueError('unexpected working directory')
    with open(f'{root}.tmp', mode = ('w' if args.force else 'x')) as ous:
        c_id = ('PressMint-FI.ana' if args.ana else 'PressMint-FI')
        print(( f'<teiCorpus xmlns="http://www.tei-c.org/ns/1.0"'
                f' xml:id="{c_id}"'
                f' xml:lang="mul">' # bound to be at least fi, sv, und
               ),
              file = ous)
        print(teiHeader,
              file = ous)
        if args.ana:
            # include all year/*.xml files in .ana.xml, assume all
            # four-character files are four-digit directories
            for component in sorted(Path('.').glob('????/*.ana.xml')):
                print(XINCLUDE.format(component),
                      file = ous)
            else: pass
        else:
            # include all year/*.xml files not in .ana.xml, .assume
            # all four-character files are four-digit directories
            for component in sorted(Path('.').glob('????/*.xml')):
                if component.name.endswith('.ana.xml'):
                    continue
                print(XINCLUDE.format(component),
                      file = ous)
            else: pass
        print('</teiCorpus>',
              file = ous)
    os.rename(f'{root}.tmp', f'{root}.xml')

if __name__ == '__main__':
    main(parser().parse_args())
